# ==============================================================================
# ZeroToSaaS - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and provide your secret credentials.
# In local development, sensible defaults or mock fallbacks are used automatically.

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL & Drizzle ORM)
# ------------------------------------------------------------------------------
# Local Docker Postgres (run: docker compose up -d) or hosted PostgreSQL (Neon, Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zerotosaas"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Generate a secure secret using: `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production"

# OAuth: Google Cloud Console -> APIs & Services -> Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth: GitHub Developer Settings -> OAuth Apps
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ------------------------------------------------------------------------------
# 3. Transactional Emails (Resend & React Email)
# ------------------------------------------------------------------------------
# Resend API Key: https://resend.com/api-keys
# If left blank in development, emails are safely logged to the console without crashing.
RESEND_API_KEY=""

# Sender email address verified in your Resend account domain
EMAIL_FROM="ZeroToSaaS <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. Payments & Subscriptions (LemonSqueezy)
# ------------------------------------------------------------------------------
# LemonSqueezy Dashboard -> Settings -> API Keys
LEMONSQUEEZY_API_KEY=""

# LemonSqueezy Dashboard -> Stores
LEMONSQUEEZY_STORE_ID=""

# LemonSqueezy Dashboard -> Webhooks (Signing Secret)
LEMONSQUEEZY_WEBHOOK_SECRET=""

# LemonSqueezy Product Variant IDs (Store -> Products -> Variants)
NEXT_PUBLIC_LS_PRO_MONTHLY_VARIANT_ID=""
NEXT_PUBLIC_LS_PRO_YEARLY_VARIANT_ID=""

# ------------------------------------------------------------------------------
# 5. App Configuration
# ------------------------------------------------------------------------------
# Public application URL (used for redirects, sitemaps, and absolute URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
