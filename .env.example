# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zerotosaas"

# Auth.js / NextAuth v5 Configuration
# Generate a secret: npx auth secret or openssl rand -base64 33
AUTH_SECRET="your-super-secret-key-change-this-in-production-min-32-chars"

# OAuth Providers (Optional for local testing)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
